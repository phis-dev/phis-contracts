{
  "name": "@phis/addon-contract",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "description": "The types and constants a phi-server Add-on declares or implements. No runtime code.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phis-dev/phis-addon-contract.git"
  },
  "homepage": "https://github.com/phis-dev/phis-addon-contract#readme",
  "bugs": {
    "url": "https://github.com/phis-dev/phis-addon-contract/issues"
  }
}
